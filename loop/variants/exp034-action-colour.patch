+<p class="note">Rooms are quiet after 21:00.</p>
+</main>
+<!-- not counted: a wordmark -->
+<footer><span class="wordmark">Northline</span>, 14 Dock Street</footer>
+<script>document.getElementById('q').focus();</script>
+</body></html>
