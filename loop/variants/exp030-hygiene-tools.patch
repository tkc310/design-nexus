+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Focus rings: contrast against the surface they are drawn on</title>
+<meta name="description" content="F02 fixture: rings below 3:1 (outside, inside, carried by a label, in a closed dialog) and rings that must not be reported.">
+<style>
+  :root { --bg: #FFFFFF; --ink: #1F2328; --sun: #F5C400; --bar: #1C1E22; --rose: #B0175F; --s2: 8px; --s3: 16px; --s4: 24px; }
+  * { box-sizing: border-box; }
+  body { margin: 0; background: var(--bg); color: var(--ink); font-family: Georgia, serif; font-size: 17px; line-height: 1.6; }
+  main { max-width: 60rem; margin: 0 auto; padding: var(--s4); display: grid; gap: var(--s4); }
+  h1 { text-wrap: balance; }
+  button, .btn { font: inherit; min-height: 44px; padding: var(--s2) var(--s3); border: 2px solid var(--ink); background: var(--bg); color: var(--ink); }
+  /* The ring every case starts from: fine on white. */
+  :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
+  /* Below 3:1 */
+  .bar { background: var(--bar); padding: var(--s3); }
+  .bar a { color: #FFFFFF; display: inline-block; padding: var(--s2); }
+  .bar a:focus-visible { outline-color: var(--rose); }               /* 2.5:1 on the dark bar */
+  #weak:focus-visible { outline-color: var(--sun); }                  /* 1.6:1 on the white page */
+  #inside:focus-visible { outline-color: var(--sun); outline-offset: -8px; } /* drawn on the button's own white fill */
+  .seg { display: inline-grid; grid-template-columns: 1fr 1fr; border: 2px solid var(--ink); }
+  .seg label { position: relative; padding: var(--s3); }
+  .seg input { position: absolute; inset: 0; opacity: 0; margin: 0; }
+  .seg label:has(input:focus-visible) { outline: 4px solid var(--sun); outline-offset: -6px; } /* the label carries the ring */
+  dialog { border: 0; padding: var(--s4); background: #F6F5F1; }
+  dialog :focus-visible { outline-color: var(--sun); }               /* seen only once the dialog is open */
+  /* Not to be reported */
+  .mid { background: #8A8F98; padding: var(--s4); }
+  #two:focus-visible { outline: 0; box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 5px #111111; } /* the inner ring is weak here, the outer one is not */
+  .photo { position: relative; height: 120px; }
+  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+  .photo button { position: absolute; left: var(--s3); top: var(--s3); }
+  #over-photo:focus-visible { outline-color: var(--sun); }            /* over an image: the surface is unknown */
+  .wash { background: linear-gradient(90deg, #FFFFFF, #1F2328); padding: var(--s4); }
+  #over-wash:focus-visible { outline-color: var(--sun); }             /* over a gradient: unknown */
+  #flip:focus-visible { outline-color: var(--sun); background: var(--ink); color: #FFFFFF; } /* the fill flips: an indicator by itself */
+  .check { position: relative; display: inline-flex; gap: var(--s2); align-items: center; min-height: 44px; }
+  .check input { position: absolute; width: 1px; height: 1px; opacity: 0; outline: 0; }
+  .check .box { width: 24px; height: 24px; border: 2px solid var(--ink); }
+  .check input:focus-visible + .box { outline: 3px solid var(--ink); outline-offset: 2px; } /* a sibling carries a strong ring */
+  #native:focus-visible { outline: revert; }                          /* the browser's own ring */
+</style>
+</head>
+<body>
+<main>
+  <h1>Focus rings</h1>
+  <nav class="bar" aria-label="App"><a href="#work">My work</a> <a href="#inbox">Inbox</a></nav>
+  <p><button id="weak" type="button">Move to Review</button> <button id="inside" type="button">Weekdays</button></p>
+  <fieldset><legend>Day type</legend>
+    <div class="seg"><label><input type="radio" name="dt" id="seg-a" checked>Weekday</label><label><input type="radio" name="dt" id="seg-b">Holiday</label></div>
+  </fieldset>
+  <dialog id="board" aria-label="Full board"><button id="dlg-close" type="button">Close board</button></dialog>
+  <p><button id="ok" type="button">Save changes</button> <button id="flip" type="button">Open the map</button> <button id="native" type="button">Print</button></p>
+  <div class="mid"><button id="two" type="button">Two-color ring</button></div>
+  <div class="photo"><img alt="" width="8" height="8" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEklEQVR4nGP8z4AdMOEQHxgJAGZDAQ8XQRRBAAAAAElFTkSuQmCC"><button id="over-photo" type="button">Over a photo</button></div>
+  <div class="wash"><button id="over-wash" type="button">Over a gradient</button></div>
+  <label class="check"><input type="checkbox" id="agree"><span class="box"></span>Email me the schedule</label>
+</main>
+</body>
+</html>
