+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Text faded with opacity</title>
+<meta name="description" content="F01 fixture: text whose colors pass but which opacity fades below 4.5:1, and the cases the check leaves alone.">
+<style>
+  :root { --bg: #FFFFFF; --ink: #1F2328; --accent: #8A3B12; --s2: 8px; --s3: 16px; --s4: 24px; }
+  * { box-sizing: border-box; }
+  body { margin: 0; background: var(--bg); color: var(--ink); font-family: Georgia, serif; font-size: 17px; line-height: 1.6; }
+  main { max-width: 60rem; margin: 0 auto; padding: var(--s4); }
+  h1 { text-wrap: balance; }
+  ul { list-style: none; padding: 0; }
+  button { font: inherit; min-height: 44px; padding: var(--s2) var(--s3); border: 2px solid var(--ink); background: var(--accent); color: #FFFFFF; }
+  button:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
+  /* Reported: the fade is on the text itself, or on a row above it. */
+  #caption { opacity: 0.45; }
+  .past { opacity: 0.5; }
+  /* Recorded only: a disabled control is exempt. */
+  button:disabled { opacity: 0.5; }
+  /* Left alone */
+  #soft { opacity: 0.9; }                      /* still 4.5:1 */
+  .deco { opacity: 0.12; font-size: 48px; }    /* decoration, hidden from assistive technology */
+  #gone { opacity: 0; }                        /* not shown at all */
+  #pulse { animation: pulse 1.2s ease-in-out infinite; }
+  @keyframes pulse { 50% { opacity: 0.3; } }   /* a running fade is taken at full strength */
+  @media (prefers-reduced-motion: reduce) { #pulse { animation: none; } }
+</style>
+</head>
+<body>
+<main>
+  <h1>Route 12 timetable</h1>
+  <p id="caption">Quiet hours are off. Notifications arrive around the clock.</p>
+  <ul>
+    <li class="past"><span id="past-time">09:47 departed from stop 4</span></li>
+    <li><span id="next-time">10:47 leaves in 17 minutes</span></li>
+  </ul>
+  <p><button id="full" type="button" disabled>Sold out</button> <button id="book" type="button">Book a seat</button></p>
+  <p id="soft">Fares are shown for adults.</p>
+  <p class="deco" aria-hidden="true">12</p>
+  <p id="gone">Loading the next departures</p>
+  <p id="pulse">Checking for delays</p>
+</main>
+</body>
+</html>
