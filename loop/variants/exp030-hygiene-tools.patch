+<title>Kiln schedule — raw values beside the tokens</title>
+<meta name="description" content="R28 fixture: a token plan in :root, and rules that write literals instead of using it.">
+<style>
+  /* The plan: an 8px spacing scale, one radius, three type sizes, one duration. */
+  :root {
+    --bg: #F4F1EA; --surface: #FFFFFF; --ink: #1F2328; --muted: #4D5661; --accent: #8A3B12;
+    --s1: 4px; --s2: 8px; --s3: 16px; --s4: 24px; --s5: 40px;
+    --radius: 4px; --t-sm: 14px; --t-base: 17px; --t-lg: 28px; --dur: 140ms;
+  }
+  * { box-sizing: border-box; }
+  body { margin: 0; background: var(--bg); color: var(--ink); font-family: Georgia, serif; font-size: var(--t-base); line-height: 1.6; }
+  main { max-width: 60rem; margin: 0 auto; padding: var(--s5) var(--s3); }
+  h1 { font-size: var(--t-lg); line-height: 1.2; text-wrap: balance; }
+  /* Fifteen literals that go around the plan, in eight classes (two more are inline, in the markup). */
+  .card { background: var(--surface); padding: 13px 18px; border-radius: 3px; margin-top: 6px; }
+  .card h2 { font-size: 15px; margin: 0 0 10px; color: #5B6470; }
+  .rows { display: grid; gap: 10px; }
+  .badge { position: relative; top: 3px; border-radius: 999px; background: rgb(138 59 18 / 0.12); }
+  .action { min-height: 44px; padding: var(--s2) var(--s3); border: 1px solid var(--ink); border-radius: var(--radius); background: var(--accent); color: white;
+    font: inherit; transition: background-color 180ms ease, transform 180ms ease; }
+  .action:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
+  @media (prefers-reduced-motion: reduce) { .action { transition: none; } }
+</style>
+</head>
+<body>
+<main>
+  <h1>Kiln schedule for the week of 9 November</h1>
+  <section class="card">
+    <h2>Bisque firing</h2>
+    <div class="rows">
+      <p>Load Tuesday 08:30 <span class="badge">cone 06</span></p>
+      <p style="margin-top: 18px; color: #AA2200">Unload Thursday after 16:00</p>
+    </div>
+    <button class="action" type="button">Book a shelf</button>
+  </section>
+</main>
+</body>
+</html>
