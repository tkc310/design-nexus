+  const SKIP = 'script, style, noscript, template, textarea, select, option, pre, code, kbd, samp, svg, math';
+  const ATOMIC = /^(IMG|INPUT|SELECT|TEXTAREA|BUTTON|VIDEO|AUDIO|CANVAS|IFRAME|OBJECT|EMBED|METER|PROGRESS|svg|math)$/;
